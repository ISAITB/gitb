<?xml version="1.0" encoding="UTF-8"?>
<testcase id="msg-domibus-receive-expiry" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <name>DomibusMessaging receive expiry when no messages found</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <gitb:actor id="SUT" role="SUT"/>
        <gitb:actor id="SIMULATED"/>
    </actors>
    <steps stopOnError="false">
        <!-- WireMock always returns empty listPendingMessages response.
             After maximumPollAttempts=2 the DeferredTask expires → error report → session FAILURE. -->
        <receive id="msg" handler="DomibusMessaging" desc="Receive expires after max poll attempts">
            <input name="type">'message'</input>
            <input name="messageIdentifier">'test-msg-999'</input>
            <input name="backendAddress">$backendUrl</input>
            <input name="initialPollDelay">50</input>
            <input name="pollInterval">100</input>
            <input name="maximumPollAttempts">2</input>
        </receive>
    </steps>
</testcase>
