<?xml version="1.0" encoding="UTF-8"?>
<testcase id="msg-http-receive-basic" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <name>HttpMessagingV2 receive via CallbackManager injection</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <gitb:actor id="SUT" role="SUT"/>
        <gitb:actor id="SIMULATED"/>
    </actors>
    <steps stopOnError="true">
        <!-- Test injects MessagingReport via CallbackManager.callbackReceived() after a delay -->
        <receive id="msg" handler="HttpMessagingV2" desc="Receive HTTP callback"/>
    </steps>
</testcase>
