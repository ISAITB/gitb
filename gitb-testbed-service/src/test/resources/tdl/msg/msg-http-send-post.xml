<?xml version="1.0" encoding="UTF-8"?>
<testcase id="msg-http-send-post" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <name>HttpMessagingV2 send POST with body</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <gitb:actor id="SUT" role="SUT"/>
        <gitb:actor id="SIMULATED"/>
    </actors>
    <steps stopOnError="true">
        <send handler="HttpMessagingV2" desc="Send HTTP POST with body">
            <input name="uri">concat($backendUrl, '/http-post-target')</input>
            <input name="method">'POST'</input>
            <input name="body">'{"key":"value"}'</input>
        </send>
    </steps>
</testcase>
