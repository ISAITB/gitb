<?xml version="1.0" encoding="UTF-8"?>
<testcase id="msg-simulated-receive-result-immediate" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <name>SimulatedMessaging receive with result (immediate report, no delay)</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <gitb:actor id="SUT" role="SUT"/>
        <gitb:actor id="SIMULATED"/>
    </actors>
    <variables>
        <var name="params" type="map"/>
    </variables>
    <steps stopOnError="true">
        <assign to="params{code}">'A1'</assign>
        <!-- No 'delay' input: SimulatedMessagingHandler returns its report synchronously, so this exercises the
             non-deferred branch of the receive step's own future - which must route the report back to the
             actor's own thread before spawning result/steps (spawning a child actor off-thread would be unsafe). -->
        <receive id="msg" handler="SimulatedMessaging" desc="Receive with result (immediate report)">
            <input name="parameters">$params</input>
            <result>
                <steps>
                    <assign to="verdict">'ok-' || $msg{code}</assign>
                </steps>
                <output name="verdict">$verdict</output>
            </result>
        </receive>
        <log>'verdict=' || $msg{verdict}</log>
        <verify handler="StringValidator" desc="result/output patched onto the step variable">
            <input name="actual">$msg{verdict}</input>
            <input name="expected">'ok-A1'</input>
        </verify>
        <verify handler="StringValidator" desc="handler's own report items still present alongside the patched output">
            <input name="actual">$msg{code}</input>
            <input name="expected">'A1'</input>
        </verify>
    </steps>
</testcase>
