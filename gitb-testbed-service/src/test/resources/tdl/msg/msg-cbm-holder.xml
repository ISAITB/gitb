<?xml version="1.0" encoding="UTF-8"?>
<testcase id="msg-cbm-holder" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <name>Minimal fixture kept active long enough to back a real session for direct CallbackManager tests</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <gitb:actor id="SUT" role="SUT"/>
        <gitb:actor id="SIMULATED"/>
    </actors>
    <steps stopOnError="true">
        <!-- Never reached within these tests - they interact with CallbackManager directly and stop the
             session explicitly once done. The long delay just keeps the session (and its configured SYSTEM
             API key) registered as active in SessionManager for the duration of the test. -->
        <receive handler="SimulatedMessaging" desc="Kept active for the duration of the test">
            <input name="delay">60000</input>
        </receive>
    </steps>
</testcase>
