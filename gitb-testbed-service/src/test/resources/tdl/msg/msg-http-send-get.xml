<?xml version="1.0" encoding="UTF-8"?>
<testcase id="msg-http-send-get" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <name>HttpMessagingV2 send GET request</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <gitb:actor id="SUT" role="SUT"/>
        <gitb:actor id="SIMULATED"/>
    </actors>
    <steps stopOnError="true">
        <!-- $backendUrl is injected via AnyContent input in the test -->
        <send handler="HttpMessagingV2" desc="Send HTTP GET">
            <input name="uri">concat($backendUrl, '/http-get-target')</input>
            <input name="method">'GET'</input>
        </send>
    </steps>
</testcase>
