<?xml version="1.0" encoding="UTF-8"?>
<testcase id="msg-soap-receive-basic" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <name>SoapMessagingV2 receive via CallbackManager injection</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <gitb:actor id="SUT" role="SUT"/>
        <gitb:actor id="SIMULATED"/>
    </actors>
    <steps stopOnError="true">
        <assign to="envelope" type="object"><![CDATA['<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/"><soapenv:Body><expected/></soapenv:Body></soapenv:Envelope>']]></assign>
        <!-- Test injects MessagingReport via CallbackManager.callbackReceived() after a delay -->
        <receive id="msg" handler="SoapMessagingV2" desc="Receive SOAP callback">
            <input name="envelope">$envelope</input>
        </receive>
    </steps>
</testcase>
