<?xml version="1.0" encoding="UTF-8"?>
<testcase id="msg-http-receive-result-output" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <name>HttpMessagingV2 receive with dynamic result (output only)</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <gitb:actor id="SUT" role="SUT"/>
        <gitb:actor id="SIMULATED"/>
    </actors>
    <steps stopOnError="true">
        <!-- delay keeps the session away from the receive step below for a moment, giving the test time to fire
             a real incoming HTTP call at the system's endpoint before it is parked. -->
        <receive handler="SimulatedMessaging" desc="Delay before the real receive step is reached">
            <input name="delay">500</input>
        </receive>
        <!-- No steps, just output bindings evaluated against the real incoming request. -->
        <receive id="msg" handler="HttpMessagingV2" desc="Receive with dynamic result (output only)">
            <result>
                <output name="status">'201'</output>
                <output name="body">$msg{request}{body}</output>
            </result>
        </receive>
    </steps>
</testcase>
