<?xml version="1.0" encoding="UTF-8"?>
<testcase id="msg-simulated-send-receive" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <name>SimulatedMessaging send then receive</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <gitb:actor id="SUT" role="SUT"/>
        <gitb:actor id="SIMULATED"/>
    </actors>
    <variables>
        <var name="params" type="map"/>
    </variables>
    <steps stopOnError="true">
        <assign to="params{value}">'world'</assign>
        <send handler="SimulatedMessaging" desc="Send outbound message"/>
        <receive id="msg" handler="SimulatedMessaging" desc="Receive inbound message">
            <input name="parameters">$params</input>
        </receive>
        <verify handler="StringValidator" desc="received value">
            <input name="actual">$msg{value}</input>
            <input name="expected">'world'</input>
        </verify>
    </steps>
</testcase>
