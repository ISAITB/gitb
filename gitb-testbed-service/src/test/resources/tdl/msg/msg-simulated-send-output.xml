<?xml version="1.0" encoding="UTF-8"?>
<testcase id="msg-simulated-send-output" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <name>SimulatedMessaging send output captured in variable</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <gitb:actor id="SUT" role="SUT"/>
        <gitb:actor id="SIMULATED"/>
    </actors>
    <variables>
        <var name="params" type="map"/>
    </variables>
    <steps stopOnError="true">
        <assign to="params{greeting}">'hello'</assign>
        <send id="sent" handler="SimulatedMessaging" desc="Send with parameters output">
            <input name="parameters">$params</input>
        </send>
        <!-- parameters items are placed in the message for report and captured as step output -->
        <verify handler="StringValidator" desc="captured output value">
            <input name="actual">$sent{greeting}</input>
            <input name="expected">'hello'</input>
        </verify>
    </steps>
</testcase>
