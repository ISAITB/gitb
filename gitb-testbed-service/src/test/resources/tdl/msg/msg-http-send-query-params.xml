<?xml version="1.0" encoding="UTF-8"?>
<testcase id="msg-http-send-query-params" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <name>HttpMessagingV2 send GET with query parameters</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <gitb:actor id="SUT" role="SUT"/>
        <gitb:actor id="SIMULATED"/>
    </actors>
    <variables>
        <var name="qp" type="map"/>
    </variables>
    <steps stopOnError="true">
        <assign to="qp{search}">'test'</assign>
        <send handler="HttpMessagingV2" desc="Send HTTP GET with query parameters">
            <input name="uri">concat($backendUrl, '/http-query-target')</input>
            <input name="method">'GET'</input>
            <input name="queryParameters">$qp</input>
        </send>
    </steps>
</testcase>
