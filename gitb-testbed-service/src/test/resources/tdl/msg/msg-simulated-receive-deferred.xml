<?xml version="1.0" encoding="UTF-8"?>
<testcase id="msg-simulated-receive-deferred" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <name>SimulatedMessaging receive via deferred async callback</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <gitb:actor id="SUT" role="SUT"/>
        <gitb:actor id="SIMULATED"/>
    </actors>
    <steps stopOnError="true">
        <!-- delay=50 triggers the async deferred path: handler returns DeferredMessagingReport,
             then schedules CallbackManager.callbackReceived() after 50ms -->
        <receive id="msg" handler="SimulatedMessaging" desc="Receive via deferred callback">
            <input name="delay">50</input>
        </receive>
    </steps>
</testcase>
