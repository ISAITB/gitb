<?xml version="1.0" encoding="UTF-8"?>
<testcase id="msg-http-receive-result-timeout" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <name>HttpMessagingV2 receive with dynamic result that exceeds its own timeout</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <gitb:actor id="SUT" role="SUT"/>
        <gitb:actor id="SIMULATED"/>
    </actors>
    <steps stopOnError="true">
        <receive handler="SimulatedMessaging" desc="Delay before the real receive step is reached">
            <input name="delay">500</input>
        </receive>
        <!-- result/@timeout (300ms) is far shorter than the delay below (2000ms), so it is expected to expire
             before result/steps ever completes. -->
        <receive id="msg" handler="HttpMessagingV2" desc="Receive with dynamic result that times out">
            <result timeout="300">
                <steps>
                    <receive handler="SimulatedMessaging" desc="Sleep longer than the result timeout">
                        <input name="delay">2000</input>
                    </receive>
                </steps>
                <output name="status">'200'</output>
            </result>
        </receive>
    </steps>
</testcase>
