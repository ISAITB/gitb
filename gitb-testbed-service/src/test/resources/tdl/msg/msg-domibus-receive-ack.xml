<?xml version="1.0" encoding="UTF-8"?>
<testcase id="msg-domibus-receive-ack" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <name>DomibusMessaging receive acknowledgement via polling</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <gitb:actor id="SUT" role="SUT"/>
        <gitb:actor id="SIMULATED"/>
    </actors>
    <steps stopOnError="true">
        <!-- DeferredTask polls the Domibus backend (WireMock) for message status.
             WireMock returns ACKNOWLEDGED on first poll → step completes with SUCCESS. -->
        <receive id="msg" handler="DomibusMessaging" desc="Receive Domibus acknowledgement">
            <input name="type">'acknowledgement'</input>
            <input name="messageIdentifier">'test-msg-001'</input>
            <input name="backendAddress">$backendUrl</input>
            <input name="initialPollDelay">50</input>
            <input name="pollInterval">100</input>
            <input name="maximumPollAttempts">5</input>
        </receive>
    </steps>
</testcase>
