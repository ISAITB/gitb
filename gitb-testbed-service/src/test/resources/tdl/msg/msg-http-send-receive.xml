<?xml version="1.0" encoding="UTF-8"?>
<testcase id="msg-http-send-receive" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <name>HttpMessagingV2 send then receive</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <gitb:actor id="SUT" role="SUT"/>
        <gitb:actor id="SIMULATED"/>
    </actors>
    <steps stopOnError="true">
        <send handler="HttpMessagingV2" desc="Send HTTP GET to WireMock">
            <input name="uri">concat($backendUrl, '/http-get-target')</input>
            <input name="method">'GET'</input>
        </send>
        <!-- CallbackManager.callbackReceived() is injected by test after a delay -->
        <receive id="msg" handler="HttpMessagingV2" desc="Receive HTTP callback"/>
    </steps>
</testcase>
