<?xml version="1.0" encoding="UTF-8"?>
<testcase id="msg-simulated-send-report-items" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <name>SimulatedMessaging send with WARNING result yields SUCCESS session</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <gitb:actor id="SUT" role="SUT"/>
        <gitb:actor id="SIMULATED"/>
    </actors>
    <steps stopOnError="true">
        <!-- WARNING step result still leads to SUCCESS session outcome -->
        <send handler="SimulatedMessaging" desc="Send with WARNING result">
            <input name="result">'WARNING'</input>
        </send>
    </steps>
</testcase>
