<?xml version="1.0" encoding="UTF-8"?>
<testcase id="msg-simulated-send-invert" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <name>SimulatedMessaging send with invert - FAILURE becomes SUCCESS</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <gitb:actor id="SUT" role="SUT"/>
        <gitb:actor id="SIMULATED"/>
    </actors>
    <steps stopOnError="true">
        <!-- invert=true: a FAILURE result from the handler is treated as SUCCESS -->
        <send handler="SimulatedMessaging" desc="Send expecting failure to be inverted" invert="true">
            <input name="result">'FAILURE'</input>
        </send>
    </steps>
</testcase>
