<?xml version="1.0" encoding="UTF-8"?>
<testcase id="expr-empty-check" xmlns="http://www.gitb.com/tdl/v1/">
    <metadata>
        <name>Empty and exists checks</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <actor id="SUT" role="SUT"/>
    </actors>
    <steps stopOnError="true">
        <assign to="emptyStr">' '</assign>
        <assign to="nonEmpty">'hello'</assign>
        <verify handler="ExpressionValidator" desc="non-empty string has length">
            <input name="expression">string-length(normalize-space($nonEmpty)) &gt; 0</input>
        </verify>
        <verify handler="ExpressionValidator" desc="empty-ish string normalises to empty">
            <input name="expression">string-length(normalize-space($emptyStr)) = 0</input>
        </verify>
        <!-- exists() and empty() on lists -->
        <assign to="myList" append="true">'a'</assign>
        <verify handler="ExpressionValidator" desc="list has items">
            <input name="expression">exists($myList)</input>
        </verify>
    </steps>
</testcase>
