<?xml version="1.0" encoding="UTF-8"?>
<testcase id="expr-string-concat" xmlns="http://www.gitb.com/tdl/v1/">
    <metadata>
        <name>String concatenation</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <actor id="SUT" role="SUT"/>
    </actors>
    <steps stopOnError="true">
        <assign to="a">'Hello'</assign>
        <assign to="b">' World'</assign>
        <assign to="result">$a || $b</assign>
        <verify handler="StringValidator" desc="Concat result">
            <input name="actual">$result</input>
            <input name="expected">'Hello World'</input>
        </verify>
    </steps>
</testcase>
