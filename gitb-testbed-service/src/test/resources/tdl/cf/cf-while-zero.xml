<?xml version="1.0" encoding="UTF-8"?>
<testcase id="cf-while-zero" xmlns="http://www.gitb.com/tdl/v1/">
    <metadata>
        <name>While condition false from start</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <actor id="SUT" role="SUT"/>
    </actors>
    <steps stopOnError="true">
        <assign to="counter" type="number">10</assign>
        <while>
            <cond>$counter &lt; 5</cond>
            <do>
                <steps>
                    <assign to="counter" type="number">$counter + 1</assign>
                </steps>
            </do>
        </while>
        <!-- counter should still be 10 -->
        <verify handler="ExpressionValidator" desc="loop body never ran">
            <input name="expression">$counter = 10</input>
        </verify>
    </steps>
</testcase>
