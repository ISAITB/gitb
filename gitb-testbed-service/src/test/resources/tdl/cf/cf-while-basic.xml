<?xml version="1.0" encoding="UTF-8"?>
<testcase id="cf-while-basic" xmlns="http://www.gitb.com/tdl/v1/">
    <metadata>
        <name>While loop 3 iterations</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <actor id="SUT" role="SUT"/>
    </actors>
    <steps stopOnError="true">
        <assign to="counter" type="number">0</assign>
        <while>
            <cond>$counter &lt; 3</cond>
            <do>
                <assign to="counter" type="number">$counter + 1</assign>
                <log>'iteration ' || $counter</log>
            </do>
        </while>
        <verify handler="ExpressionValidator" desc="counter reached 3">
            <input name="expression">$counter = 3</input>
        </verify>
    </steps>
</testcase>
