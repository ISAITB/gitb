<testcase id="val-xml-schematron-xslt-document" xmlns="http://www.gitb.com/tdl/v1/">
    <metadata>
        <name>XmlValidator XSLT-based Schematron loads a test suite artifact via document()</name>
        <version>1.0</version>
    </metadata>
    <imports>
        <artifact type="schema" encoding="UTF-8" name="rules">schematron/rules.xslt</artifact>
    </imports>
    <actors>
        <actor id="SUT" role="SUT"/>
    </actors>
    <steps stopOnError="true">
        <assign to="xmlDoc" type="object"><![CDATA['<doc><item code="A"/><item code="Z"/></doc>']]></assign>
        <assign to="schList" append="true">$rules</assign>
        <verify handler="XmlValidator" desc="The value set loaded via document() is applied">
            <input name="xml">$xmlDoc</input>
            <input name="schematron">$schList</input>
        </verify>
    </steps>
</testcase>
