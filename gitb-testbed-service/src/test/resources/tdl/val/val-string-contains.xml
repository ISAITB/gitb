<?xml version="1.0" encoding="UTF-8"?>
<testcase id="val-string-contains" xmlns="http://www.gitb.com/tdl/v1/">
    <metadata>
        <name>ExpressionValidator contains check</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <actor id="SUT" role="SUT"/>
    </actors>
    <steps stopOnError="true">
        <assign to="message">'The quick brown fox'</assign>
        <verify handler="ExpressionValidator" desc="contains 'quick'">
            <input name="expression">contains($message, 'quick')</input>
        </verify>
        <verify handler="ExpressionValidator" desc="does not contain 'slow'">
            <input name="expression">not(contains($message, 'slow'))</input>
        </verify>
        <verify handler="ExpressionValidator" desc="starts with 'The'">
            <input name="expression">starts-with($message, 'The')</input>
        </verify>
    </steps>
</testcase>
