<?xml version="1.0" encoding="UTF-8"?>
<testcase id="val-pdf-unparseable" xmlns="http://www.gitb.com/tdl/v1/">
    <metadata>
        <name>PdfValidator core parse of non-PDF content</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <actor id="SUT" role="SUT"/>
    </actors>
    <steps stopOnError="true">
        <assign to="notAPdf">'This is not a PDF document.'</assign>
        <verify handler="PdfValidator" desc="content is not a PDF document at all">
            <input name="content">$notAPdf</input>
        </verify>
    </steps>
</testcase>
