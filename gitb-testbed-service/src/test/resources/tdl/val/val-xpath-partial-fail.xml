<?xml version="1.0" encoding="UTF-8"?>
<testcase id="val-xpath-partial-fail" xmlns="http://www.gitb.com/tdl/v1/">
    <metadata>
        <name>XPathValidator false expression fails session</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <actor id="SUT" role="SUT"/>
    </actors>
    <steps stopOnError="true">
        <assign to="xmlDoc" type="object"><![CDATA['<order><status>pending</status></order>']]></assign>
        <verify handler="XPathValidator" desc="expects approved but gets pending">
            <input name="xml">$xmlDoc</input>
            <input name="expression">/order/status = 'approved'</input>
        </verify>
    </steps>
</testcase>
