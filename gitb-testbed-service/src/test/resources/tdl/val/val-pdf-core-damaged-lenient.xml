<?xml version="1.0" encoding="UTF-8"?>
<testcase id="val-pdf-core-damaged-lenient" xmlns="http://www.gitb.com/tdl/v1/">
    <metadata>
        <name>PdfValidator core parse of a damaged PDF without strictMode</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <actor id="SUT" role="SUT"/>
    </actors>
    <steps stopOnError="true">
        <verify handler="PdfValidator" desc="damaged PDF header, recoverable issue reported as a warning">
            <input name="content">$content</input>
        </verify>
    </steps>
</testcase>
