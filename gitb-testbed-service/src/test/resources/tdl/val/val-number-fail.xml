<?xml version="1.0" encoding="UTF-8"?>
<testcase id="val-number-fail" xmlns="http://www.gitb.com/tdl/v1/">
    <metadata>
        <name>NumberValidator inequality fails session</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <actor id="SUT" role="SUT"/>
    </actors>
    <steps stopOnError="true">
        <assign to="actual" type="number">42</assign>
        <verify handler="NumberValidator" desc="wrong expected value">
            <input name="actual">$actual</input>
            <input name="expected" type="number">99</input>
        </verify>
    </steps>
</testcase>
