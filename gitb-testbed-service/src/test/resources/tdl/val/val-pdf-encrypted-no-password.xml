<?xml version="1.0" encoding="UTF-8"?>
<testcase id="val-pdf-encrypted-no-password" xmlns="http://www.gitb.com/tdl/v1/">
    <metadata>
        <name>PdfValidator core parse of an encrypted PDF without a password</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <actor id="SUT" role="SUT"/>
    </actors>
    <steps stopOnError="true">
        <verify handler="PdfValidator" desc="encrypted PDF, no password provided">
            <input name="content">$content</input>
        </verify>
    </steps>
</testcase>
