<?xml version="1.0" encoding="UTF-8"?>
<testcase id="val-number-equal" xmlns="http://www.gitb.com/tdl/v1/">
    <metadata>
        <name>NumberValidator exact equality</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <actor id="SUT" role="SUT"/>
    </actors>
    <steps stopOnError="true">
        <assign to="n" type="number">99</assign>
        <verify handler="NumberValidator" desc="n equals 99">
            <input name="actual">$n</input>
            <input name="expected" type="number">99</input>
        </verify>
    </steps>
</testcase>
