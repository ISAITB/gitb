<?xml version="1.0" encoding="UTF-8"?>
<testcase id="val-xml-schematron-include-remote" xmlns="http://www.gitb.com/tdl/v1/">
    <metadata>
        <name>XmlValidator pure Schematron with a remote include is blocked</name>
        <version>1.0</version>
    </metadata>
    <variables>
        <var name="remoteUrl" type="string"/>
    </variables>
    <actors>
        <actor id="SUT" role="SUT"/>
    </actors>
    <steps stopOnError="true">
        <assign to="xmlDoc" type="object"><![CDATA['<invoice><total>100</total></invoice>']]></assign>
        <assign to="schText"><![CDATA[concat('<sch:schema xmlns:sch="http://purl.oclc.org/dsdl/schematron"><sch:include href="', $remoteUrl, '"/></sch:schema>')]]></assign>
        <assign to="schList" append="true">$schText</assign>
        <verify handler="XmlValidator" desc="Remote include is blocked">
            <input name="xml">$xmlDoc</input>
            <input name="schematron">$schList</input>
        </verify>
    </steps>
</testcase>
