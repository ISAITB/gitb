<?xml version="1.0" encoding="UTF-8"?>
<testcase id="val-pdf-core-valid" xmlns="http://www.gitb.com/tdl/v1/">
    <metadata>
        <name>PdfValidator core parse of a well-formed PDF</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <actor id="SUT" role="SUT"/>
    </actors>
    <steps stopOnError="true">
        <verify handler="PdfValidator" desc="well-formed PDF, no profiles requested">
            <input name="content">$content</input>
        </verify>
    </steps>
</testcase>
