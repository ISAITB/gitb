<?xml version="1.0" encoding="UTF-8"?>
<testcase id="val-json-valid" xmlns="http://www.gitb.com/tdl/v1/">
    <metadata>
        <name>JsonValidator valid JSON against inline schema</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <actor id="SUT" role="SUT"/>
    </actors>
    <steps stopOnError="true">
        <assign to="json">'{"name":"Alice","age":30}'</assign>
        <assign to="schema">'{"type":"object","required":["name","age"],"properties":{"name":{"type":"string"},"age":{"type":"integer"}}}'</assign>
        <assign to="schemaList" append="true">$schema</assign>
        <verify handler="JsonValidator" desc="valid JSON against schema">
            <input name="json">$json</input>
            <input name="schema">$schemaList</input>
        </verify>
    </steps>
</testcase>
