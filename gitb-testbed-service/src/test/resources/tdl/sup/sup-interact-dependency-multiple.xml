<?xml version="1.0" encoding="UTF-8"?>
<testcase id="sup-interact-dependency-multiple" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <name>Interact dependencies on multiple selection dropdowns match any selected value</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <gitb:actor id="SUT" role="SUT"/>
    </actors>
    <steps stopOnError="true">
        <interact id="data" desc="Provide inputs">
            <request desc="Implicit" name="implicit" options="a,b,c" multiple="true"/>
            <request desc="Depends on implicit" name="implicitDependent" dependsOn="implicit" dependsOnValue="b" required="true"/>
            <request desc="Explicit" name="explicit" inputType="SELECT_MULTIPLE" options="a,b,c"/>
            <request desc="Depends on explicit" name="explicitDependent" dependsOn="explicit" dependsOnValue="b" required="true"/>
        </interact>
    </steps>
</testcase>
