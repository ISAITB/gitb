<?xml version="1.0" encoding="UTF-8"?>
<testcase id="sup-group-steps" xmlns="http://www.gitb.com/tdl/v1/">
    <metadata>
        <name>Group with name executes all child steps</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <actor id="SUT" role="SUT"/>
    </actors>
    <steps stopOnError="true">
        <assign to="total" type="number">0</assign>
        <group desc="Accumulate group">
            <assign to="total" type="number">$total + 10</assign>
            <assign to="total" type="number">$total + 20</assign>
            <assign to="total" type="number">$total + 30</assign>
        </group>
        <verify handler="ExpressionValidator" desc="all assigns in group ran">
            <input name="expression">$total = 60</input>
        </verify>
    </steps>
</testcase>
