<?xml version="1.0" encoding="UTF-8"?>
<testcase id="sup-interact-radio-checkbox" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <name>Interact radio buttons and checkboxes record the selected values</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <gitb:actor id="SUT" role="SUT"/>
    </actors>
    <steps stopOnError="true">
        <assign to="bound" type="string"/>
        <interact id="data" desc="Provide inputs">
            <request desc="Radio" name="radio" inputType="RADIO_BUTTON" options="a,b,c"/>
            <request desc="Radio ignoring multiple" name="radioMultiple" inputType="RADIO_BUTTON" options="a,b,c" multiple="true"/>
            <request desc="Checkboxes" name="checkboxes" inputType="CHECKBOX" options="a,b,c"/>
            <request desc="Checkboxes ignoring multiple" name="checkboxesMultiple" inputType="CHECKBOX" options="a,b,c" multiple="false"/>
            <request desc="Single checkbox checked" name="loneChecked" inputType="CHECKBOX"/>
            <request desc="Single checkbox unchecked" name="loneUnchecked" inputType="CHECKBOX"/>
            <request desc="Single checkbox as string" name="loneString" inputType="CHECKBOX" type="string"/>
            <request desc="Bound checkboxes" inputType="CHECKBOX" options="a,b,c">$bound</request>
        </interact>
        <verify handler="StringValidator" desc="Radio">
            <input name="actual">$data{radio}</input>
            <input name="expected">'b'</input>
        </verify>
        <verify handler="StringValidator" desc="Radio ignoring multiple">
            <input name="actual">$data{radioMultiple}</input>
            <input name="expected">'c'</input>
        </verify>
        <verify handler="StringValidator" desc="Checkboxes">
            <input name="actual">$data{checkboxes}</input>
            <input name="expected">'a,c'</input>
        </verify>
        <verify handler="StringValidator" desc="Checkboxes ignoring multiple">
            <input name="actual">$data{checkboxesMultiple}</input>
            <input name="expected">'a,b'</input>
        </verify>
        <verify handler="ExpressionValidator" desc="Single checkbox checked is a true boolean">
            <input name="expression">$data{loneChecked} = true()</input>
        </verify>
        <verify handler="ExpressionValidator" desc="Single checkbox unchecked is a false boolean">
            <input name="expression">$data{loneUnchecked} = false()</input>
        </verify>
        <verify handler="StringValidator" desc="Single checkbox as string">
            <input name="actual">$data{loneString}</input>
            <input name="expected">'true'</input>
        </verify>
        <verify handler="StringValidator" desc="Bound checkboxes">
            <input name="actual">$bound</input>
            <input name="expected">'b,c'</input>
        </verify>
    </steps>
</testcase>
