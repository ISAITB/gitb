<?xml version="1.0" encoding="UTF-8"?>
<testcase id="sup-interact-dependency-values" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <name>Interact dependencies on inputs with multiple values match any of the values</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <gitb:actor id="SUT" role="SUT"/>
    </actors>
    <steps stopOnError="true">
        <interact id="data" desc="Provide inputs">
            <request desc="Text" name="text" multiple="true"/>
            <request desc="Depends on any text value" name="textDependent" dependsOn="text" dependsOnValue="t2" required="true"/>
            <request desc="Rich" name="rich" inputType="RICH_TEXT" multiple="true"/>
            <request desc="Depends on any rich value" name="richDependent" dependsOn="rich" dependsOnValue="&lt;p&gt;r2&lt;/p&gt;" required="true"/>
        </interact>
    </steps>
</testcase>
