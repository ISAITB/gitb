<?xml version="1.0" encoding="UTF-8"?>
<testcase id="sup-interact-dependency-radio-checkbox" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <name>Interact dependencies on radio buttons and checkboxes</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <gitb:actor id="SUT" role="SUT"/>
    </actors>
    <steps stopOnError="true">
        <interact id="data" desc="Provide inputs">
            <request desc="Radio" name="radio" inputType="RADIO_BUTTON" options="a,b,c"/>
            <request desc="Depends on radio" name="radioDependent" dependsOn="radio" dependsOnValue="b" required="true"/>
            <request desc="Checkboxes" name="checkboxes" inputType="CHECKBOX" options="a,b,c"/>
            <request desc="Depends on checkboxes" name="checkboxesDependent" dependsOn="checkboxes" dependsOnValue="b" required="true"/>
            <request desc="Single checkbox" name="lone" inputType="CHECKBOX"/>
            <request desc="Depends on checked" name="loneCheckedDependent" dependsOn="lone" dependsOnValue="true" required="true"/>
            <request desc="Depends on unchecked" name="loneUncheckedDependent" dependsOn="lone" dependsOnValue="false" required="true"/>
        </interact>
    </steps>
</testcase>
