<?xml version="1.0" encoding="UTF-8"?>
<testcase id="sup-assign-string" xmlns="http://www.gitb.com/tdl/v1/">
    <metadata>
        <name>Assign string literal</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <actor id="SUT" role="SUT"/>
    </actors>
    <steps stopOnError="true">
        <assign to="greeting">'Hello, World!'</assign>
        <verify handler="StringValidator" desc="assigned string">
            <input name="actual">$greeting</input>
            <input name="expected">'Hello, World!'</input>
        </verify>
    </steps>
</testcase>
