<?xml version="1.0" encoding="UTF-8"?>
<testcase id="sup-interact-required-values" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <name>Interact required inputs are not satisfied by whitespace-only values</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <gitb:actor id="SUT" role="SUT"/>
    </actors>
    <steps stopOnError="true">
        <interact id="data" desc="Provide inputs">
            <request desc="Single" name="single" required="true"/>
            <request desc="Multiple" name="multiple" multiple="true" required="true"/>
        </interact>
    </steps>
</testcase>
