<?xml version="1.0" encoding="UTF-8"?>
<testcase id="sup-interact-radio-checkbox-required" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <name>Interact required radio buttons and checkboxes need a selection</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <gitb:actor id="SUT" role="SUT"/>
    </actors>
    <steps stopOnError="true">
        <interact id="data" desc="Provide inputs">
            <request desc="Radio" name="radio" inputType="RADIO_BUTTON" options="a,b" required="true"/>
            <request desc="Checkboxes" name="checkboxes" inputType="CHECKBOX" options="a,b" required="true"/>
            <request desc="Consent" name="consent" inputType="CHECKBOX" required="true"/>
        </interact>
    </steps>
</testcase>
