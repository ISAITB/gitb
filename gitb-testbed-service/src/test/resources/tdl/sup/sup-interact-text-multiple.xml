<?xml version="1.0" encoding="UTF-8"?>
<testcase id="sup-interact-text-multiple" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <name>Interact text input with multiple set is recorded as a list</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <gitb:actor id="SUT" role="SUT"/>
    </actors>
    <steps stopOnError="true">
        <assign to="boundString" type="string"/>
        <assign to="boundList" type="list[string]"/>
        <interact id="data" desc="Provide inputs">
            <request desc="Text" name="text" multiple="true"/>
            <request desc="Bound to string" multiple="true">$boundString</request>
            <request desc="Bound to list" multiple="true">$boundList</request>
        </interact>
        <verify handler="StringValidator" desc="Single value in a list">
            <input name="actual">$data{text}{0}</input>
            <input name="expected">'x'</input>
        </verify>
        <verify handler="StringValidator" desc="Bound to string">
            <input name="actual">$boundString</input>
            <input name="expected">'y'</input>
        </verify>
        <verify handler="StringValidator" desc="Bound to list">
            <input name="actual">$boundList{0}</input>
            <input name="expected">'z'</input>
        </verify>
    </steps>
</testcase>
