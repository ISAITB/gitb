<?xml version="1.0" encoding="UTF-8"?>
<testcase id="proc-jsonpath-extract" xmlns="http://www.gitb.com/tdl/v1/">
    <metadata>
        <name>JsonPathProcessor extract field</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <actor id="SUT" role="SUT"/>
    </actors>
    <steps stopOnError="true">
        <assign to="json">'{"name":"Carol","age":25,"city":"Paris"}'</assign>
        <process handler="JsonPathProcessor" output="name">
            <input name="content">$json</input>
            <input name="expression">'$.name'</input>
        </process>
        <verify handler="StringValidator" desc="extracted name">
            <input name="actual">$name</input>
            <input name="expected">'Carol'</input>
        </verify>
    </steps>
</testcase>
