<?xml version="1.0" encoding="UTF-8"?>
<testcase id="proc-text-html" xmlns="http://www.gitb.com/tdl/v1/">
    <metadata>
        <name>TextProcessor HTML escape and unescape</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <actor id="SUT" role="SUT"/>
    </actors>
    <steps stopOnError="true">
        <assign to="original">"&lt;b&gt;caf&#233;&lt;/b&gt;"</assign>
        <process handler="TextProcessor" operation="htmlEscape" output="escaped">
            <input name="input">$original</input>
        </process>
        <verify handler="ExpressionValidator" desc="escaping removed the raw markup characters">
            <input name="expression">not(contains($escaped, '&lt;')) and not(contains($escaped, '&gt;')) and contains($escaped, '&amp;lt;')</input>
        </verify>
        <process handler="TextProcessor" operation="htmlUnescape" output="unescaped">
            <input name="input">$escaped</input>
        </process>
        <verify handler="StringValidator" desc="round-trip matches original">
            <input name="actual">$unescaped</input>
            <input name="expected">$original</input>
        </verify>
    </steps>
</testcase>
