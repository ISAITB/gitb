<?xml version="1.0" encoding="UTF-8"?>
<testcase id="proc-text-csv" xmlns="http://www.gitb.com/tdl/v1/">
    <metadata>
        <name>TextProcessor CSV field escape and unescape</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <actor id="SUT" role="SUT"/>
    </actors>
    <steps stopOnError="true">
        <assign to="original">"a,b ""c"""</assign>
        <process handler="TextProcessor" operation="csvEscape" output="escaped">
            <input name="input">$original</input>
        </process>
        <verify handler="ExpressionValidator" desc="a field needing escaping is wrapped in quotes">
            <input name="expression">starts-with($escaped, '"') and ends-with($escaped, '"')</input>
        </verify>
        <process handler="TextProcessor" operation="csvUnescape" output="unescaped">
            <input name="input">$escaped</input>
        </process>
        <verify handler="StringValidator" desc="round-trip matches original">
            <input name="actual">$unescaped</input>
            <input name="expected">$original</input>
        </verify>
    </steps>
</testcase>
