<?xml version="1.0" encoding="UTF-8"?>
<testcase id="proc-text-uri" xmlns="http://www.gitb.com/tdl/v1/">
    <metadata>
        <name>TextProcessor URI (RFC 3986) encode and decode</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <actor id="SUT" role="SUT"/>
    </actors>
    <steps stopOnError="true">
        <assign to="original">'a b+c/d~e*f'</assign>
        <process handler="TextProcessor" operation="uriEncode" output="encoded">
            <input name="input">$original</input>
        </process>
        <verify handler="StringValidator" desc="encoded value is as expected">
            <input name="actual">$encoded</input>
            <input name="expected">'a%20b%2Bc%2Fd~e%2Af'</input>
        </verify>
        <process handler="TextProcessor" operation="uriDecode" output="decoded">
            <input name="input">$encoded</input>
        </process>
        <verify handler="StringValidator" desc="round-trip matches original">
            <input name="actual">$decoded</input>
            <input name="expected">$original</input>
        </verify>
    </steps>
</testcase>
