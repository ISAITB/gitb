<?xml version="1.0" encoding="UTF-8"?>
<testcase id="proc-text-hex" xmlns="http://www.gitb.com/tdl/v1/">
    <metadata>
        <name>TextProcessor hex encode and decode</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <actor id="SUT" role="SUT"/>
    </actors>
    <steps stopOnError="true">
        <assign to="original">'Hello'</assign>
        <process handler="TextProcessor" operation="hexEncode" output="encoded">
            <input name="input">$original</input>
        </process>
        <verify handler="StringValidator" desc="encoded value is as expected">
            <input name="actual">$encoded</input>
            <input name="expected">'48656c6c6f'</input>
        </verify>
        <process handler="TextProcessor" operation="hexDecode" output="decoded">
            <input name="input">$encoded</input>
        </process>
        <verify handler="StringValidator" desc="round-trip matches original">
            <input name="actual">$decoded</input>
            <input name="expected">$original</input>
        </verify>
    </steps>
</testcase>
