<?xml version="1.0" encoding="UTF-8"?>
<testcase id="proc-regexp-replace" xmlns="http://www.gitb.com/tdl/v1/">
    <metadata>
        <name>RegExpProcessor replace all matches</name>
        <version>1.0</version>
    </metadata>
    <actors>
        <actor id="SUT" role="SUT"/>
    </actors>
    <steps stopOnError="true">
        <assign to="text">'Order 123 and 456'</assign>
        <process handler="RegExpProcessor" operation="replace" output="result">
            <input name="input">$text</input>
            <input name="expression">'\d+'</input>
            <input name="replacement">'N'</input>
        </process>
        <verify handler="StringValidator" desc="all matches replaced">
            <input name="actual">$result</input>
            <input name="expected">'Order N and N'</input>
        </verify>
    </steps>
</testcase>
