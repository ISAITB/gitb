<?xml version="1.0" encoding="UTF-8"?>
<testcase id="sec-lim-verify" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <name>Remote lookups in a verify step</name>
        <version>1.0</version>
    </metadata>
    <variables>
        <var name="url" type="string"/>
    </variables>
    <actors>
        <gitb:actor id="SUT" role="SUT"/>
        <gitb:actor id="SIMULATED"/>
    </actors>
    <steps stopOnError="true">
        <verify handler="StringValidator" desc="Lookups">
            <input name="actual">string(count((1 to 5) ! unparsed-text(concat($url, '?i=', .))))</input>
            <input name="expected">'5'</input>
        </verify>
    </steps>
</testcase>
