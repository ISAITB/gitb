<?xml version="1.0" encoding="UTF-8"?>
<testcase id="sec-lim-loop" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <name>Remote lookups in the steps of a loop</name>
        <version>1.0</version>
    </metadata>
    <variables>
        <var name="url" type="string"/>
    </variables>
    <actors>
        <gitb:actor id="SUT" role="SUT"/>
        <gitb:actor id="SIMULATED"/>
    </actors>
    <steps stopOnError="true">
        <assign to="counter" type="number">0</assign>
        <while>
            <cond>$counter &lt; 3</cond>
            <do>
                <assign to="n">string(count((1 to 3) ! unparsed-text(concat($url, '?i=', .))))</assign>
                <assign to="counter" type="number">$counter + 1</assign>
            </do>
        </while>
    </steps>
</testcase>
