<?xml version="1.0" encoding="UTF-8"?>
<testcase id="sec-expr-collection" xmlns="http://www.gitb.com/tdl/v1/">
    <metadata>
        <name>TDL expression listing a collection</name>
        <version>1.0</version>
    </metadata>
    <variables>
        <var name="url" type="string"/>
    </variables>
    <actors>
        <actor id="SUT" role="SUT"/>
    </actors>
    <steps stopOnError="true">
        <assign to="size">string(count(collection($url)))</assign>
        <verify handler="StringValidator" desc="Collection size">
            <input name="actual">$size</input>
            <input name="expected">'0'</input>
        </verify>
    </steps>
</testcase>
