<?xml version="1.0" encoding="UTF-8"?>
<testcase id="sec-lim-output" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <name>Remote lookups in the output message of the test case</name>
        <version>1.0</version>
    </metadata>
    <variables>
        <var name="url" type="string"/>
    </variables>
    <actors>
        <gitb:actor id="SUT" role="SUT"/>
        <gitb:actor id="SIMULATED"/>
    </actors>
    <steps stopOnError="true">
        <log>'Nothing to do'</log>
    </steps>
    <output>
        <success>
            <default>string(count((1 to 5) ! unparsed-text(concat($url, '?i=', .))))</default>
        </success>
        <failure>
            <default>'Failed'</default>
        </failure>
    </output>
</testcase>
