<?xml version="1.0" encoding="UTF-8"?>
<testcase id="sec-lim-while" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <name>Remote lookups in a while condition</name>
        <version>1.0</version>
    </metadata>
    <variables>
        <var name="url" type="string"/>
    </variables>
    <actors>
        <gitb:actor id="SUT" role="SUT"/>
        <gitb:actor id="SIMULATED"/>
    </actors>
    <steps stopOnError="true">
        <assign to="counter" type="number">0</assign>
        <while>
            <cond>$counter &lt; 3 and string-length(unparsed-text(concat($url, '?i=', $counter))) &gt; 0</cond>
            <do>
                <assign to="counter" type="number">$counter + 1</assign>
            </do>
        </while>
    </steps>
</testcase>
