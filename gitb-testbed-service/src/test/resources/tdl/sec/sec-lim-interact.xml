<?xml version="1.0" encoding="UTF-8"?>
<testcase id="sec-lim-interact" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <name>Remote lookups in the instruction of an interaction</name>
        <version>1.0</version>
    </metadata>
    <variables>
        <var name="url" type="string"/>
    </variables>
    <actors>
        <gitb:actor id="SUT" role="SUT"/>
        <gitb:actor id="SIMULATED"/>
    </actors>
    <steps stopOnError="true">
        <interact id="info" desc="Information">
            <instruct desc="Lookups" type="string">string(count((1 to 5) ! unparsed-text(concat($url, '?i=', .))))</instruct>
            <request desc="Value" name="value"/>
        </interact>
    </steps>
</testcase>
