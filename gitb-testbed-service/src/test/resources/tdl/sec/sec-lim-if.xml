<?xml version="1.0" encoding="UTF-8"?>
<testcase id="sec-lim-if" xmlns="http://www.gitb.com/tdl/v1/" xmlns:gitb="http://www.gitb.com/core/v1/">
    <metadata>
        <name>Remote lookups in an if condition</name>
        <version>1.0</version>
    </metadata>
    <variables>
        <var name="url" type="string"/>
    </variables>
    <actors>
        <gitb:actor id="SUT" role="SUT"/>
        <gitb:actor id="SIMULATED"/>
    </actors>
    <steps stopOnError="true">
        <if>
            <cond>count((1 to 5) ! unparsed-text(concat($url, '?i=', .))) = 5</cond>
            <then>
                <log>'Looked up'</log>
            </then>
        </if>
    </steps>
</testcase>
