        <version.verapdf>1.30.2</version.verapdf>
        <!--
            veraPDF's profile loading (org.verapdf.pdfa.validation.profiles.Profiles) unmarshals its
            bundled PDF/A and PDF/UA profile XMLs using the legacy javax.xml.bind (JAXB 2) API, for
            which it depends on com.sun.xml.bind:jaxb-impl. Spring Boot's own dependency management
            pins that same groupId/artifactId to a much newer version that has been repurposed as a
            jakarta.xml.bind-based bridge (it no longer contains the javax.xml.bind.v2.ContextFactory
            provider class veraPDF needs) - so it must be pinned back here to the last release still
            built against the javax.xml.bind.v2 API. Nothing else in this project depends on
            com.sun.xml.bind:jaxb-impl (it is unrelated to, and does not affect, the jakarta.xml.bind
            stack used elsewhere, e.g. by CXF).
        -->
        <version.jaxbImplLegacy>2.3.9</version.jaxbImplLegacy>
