    <reporting>
        <plugins>
            <!--
                Generate project reports with `mvn install site site:stage`.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-project-info-reports-plugin</artifactId>
                <version>${version.plugin.projectInfoReports}</version>
                <reportSets>
                    <reportSet>
                        <reports>
                            <!-- index only = suppress all default reports -->
                            <report>index</report>
                        </reports>
                    </reportSet>
                </reportSets>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <version>${version.plugin.versionsMavenPlugin}</version>
                <reportSets>
                    <!-- Aggregate report: root only -->
                    <reportSet>
                        <id>aggregate</id>
                        <inherited>false</inherited>
                        <configuration>
                            <onlyProjectDependencies>true</onlyProjectDependencies>
                            <processDependencyManagement>true</processDependencyManagement>
                        </configuration>
                        <reports>
                            <report>dependency-updates-aggregate-report</report>
                            <report>plugin-updates-report</report>
                        </reports>
                    </reportSet>
                    <!-- Per-module reports: run in each module -->
                    <reportSet>
                        <id>modules</id>
                        <configuration>
                            <onlyProjectDependencies>true</onlyProjectDependencies>
                            <processDependencyManagement>true</processDependencyManagement>
                        </configuration>
                        <reports>
                            <report>dependency-updates-report</report>
                        </reports>
                    </reportSet>
                </reportSets>
            </plugin>
        </plugins>
    </reporting>

