{
  "name": "gitb-ui-frontend",
  "version": "1.31.0-SNAPSHOT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --open --host 0.0.0.0",
    "build": "ng build --progress",
    "build:dev": "ng build --progress --watch",
    "build:prod": "ng build --progress --configuration production --output-hashing none",
    "audit": "better-npm-audit audit --production",
    "licence-report": "license-report --only=prod --output=markdown --fields=licenseType --fields=name --fields=installedVersion --fields=link",
    "licence-report-save": "npm run licence-report > ./dist/THIRD_PARTY_LICENCES.md",
    "licence-check": "license-checker-rseidelsohn --production --depth 0 --excludePrivatePackages --onlyAllow MIT;Apache-2.0 --summary",
    "licence-check-linux": "license-checker-rseidelsohn --production --depth 0 --excludePrivatePackages --onlyAllow MIT\\;Apache-2.0 --summary",
    "sbom": "cyclonedx-npm --omit dev --mc-type application --spec-version 1.6 --output-reproducible --output-format JSON --output-file ./dist/gitb-ui-frontend.bom.json"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.7",
    "@angular/cdk": "^22.1.7",
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "@angular/localize": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@angular/router": "^22.1.7",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@fortawesome/fontawesome-free": "6.7.2",
    "@hugerte/hugerte-angular": "1.1.1",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "5.3.8",
    "codemirror": "6.0.2",
    "file-saver": "2.0.5",
    "hugerte": "1.0.14",
    "marked": "18.0.13",
    "ngx-color-picker": "20.1.1",
    "ngx-cookie-service": "22.0.0",
    "ngx-markdown": "22.0.2",
    "rxjs": "7.8.2",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.7",
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.1.0",
    "better-npm-audit": "^3.11.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "license-report": "^6.8.5",
    "ts-node": "~10.9.2",
    "tslib": "^2.7.0",
    "typescript": "^6.0.3"
  }
}
