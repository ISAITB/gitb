# Stage 1: Build app
FROM sbtscala/scala-sbt:eclipse-temurin-25.0.1_8_1.12.11_2.13.18 AS builder

# Install nodejs and npm (to build frontend app)
ENV NVM_DIR=/usr/local/nvm
ENV NVM_VERSION=0.40.1
ENV NODE_VERSION=22.14.0
SHELL ["/bin/bash", "--login", "-c"]
RUN mkdir $NVM_DIR
RUN touch ~/.bashrc && chmod +x ~/.bashrc
RUN curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v$NVM_VERSION/install.sh | bash
RUN . $NVM_DIR/nvm.sh && source ~/.bashrc && nvm install $NODE_VERSION
ENV NODE_PATH=$NVM_DIR/v$NODE_VERSION/lib/node_modules
ENV PATH=$NVM_DIR/versions/node/v$NODE_VERSION/bin:$PATH

# Install Maven to build shared snapshot dependencies
ARG MAVEN_VERSION=3.9.16
ARG BASE_URL=https://dlcdn.apache.org/maven/maven-3/${MAVEN_VERSION}/binaries
ARG BASE_URL_FALLBACK=https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries
ARG USER_HOME_DIR="/root"
RUN mkdir -p /usr/share/maven /usr/share/maven/ref \
    && (curl -fsSL -o /tmp/apache-maven.tar.gz ${BASE_URL}/apache-maven-${MAVEN_VERSION}-bin.tar.gz \
        || curl -fsSL -o /tmp/apache-maven.tar.gz ${BASE_URL_FALLBACK}/apache-maven-${MAVEN_VERSION}-bin.tar.gz) \
    && tar -xzf /tmp/apache-maven.tar.gz -C /usr/share/maven --strip-components=1 \
    && rm -f /tmp/apache-maven.tar.gz \
    && ln -s /usr/share/maven/bin/mvn /usr/bin/mvn
ENV JAVA_HOME=/opt/java/openjdk
ENV MAVEN_HOME=/usr/share/maven
ENV MAVEN_CONFIG="$USER_HOME_DIR/.m2"
ENV PATH=$MAVEN_HOME/bin:$JAVA_HOME/bin:$PATH

# Build snapshot dependencies
COPY . /app
WORKDIR /app
RUN mvn clean install -DskipTests=true -Denv=docker

# Build and prepare gitb-ui app
WORKDIR /app/gitb-ui
RUN java -Dfile.encoding=UTF-8 -Xss2M -Dsbt.log.noformat=true -Dsbt.script=/usr/local/bin/sbt -Dscala.ext.dirs= -jar /usr/share/sbt/bin/sbt-launch.jar clean dist
WORKDIR /app
RUN mkdir -p /app/tmp \
    && apt-get update && apt-get install -y unzip \
    && unzip /app/gitb-ui/target/universal/gitb-1.0-SNAPSHOT.zip -d /app/tmp/gitb-ui \
    && mv /app/tmp/gitb-ui/gitb-1.0-SNAPSHOT /app/tmp/gitb-ui/gitb-ui

# Stage 2: Run application
FROM eclipse-temurin:25-jre-jammy

ARG APPLICATION_SECRET=""
ARG HMAC_KEY=""
ARG MASTER_PASSWORD=""
ARG DB_DEFAULT_PASSWORD=""

ENV PATH=/usr/local/gitb-ui/bin:$PATH
ENV TESTBED_SERVICE_URL=http://gitb-srv:8080/itbsrv/TestbedService
ENV TESTBED_CLIENT_URL_INTERNAL=http://0.0.0.0:9090/TestbedClient
ENV TESTBED_CLIENT_URL=http://gitb-ui:9090/TestbedClient
ENV DB_DEFAULT_URL=jdbc:mysql://gitb-mysql/gitb?characterEncoding=UTF-8&useUnicode=true&autoReconnect=true&useSSL=false&verifyServerCertificate=false&allowPublicKeyRetrieval=true
ENV DB_DEFAULT_ROOTURL=jdbc:mysql://gitb-mysql/
ENV REDIS_HOST=gitb-redis

COPY --from=builder /app/tmp/gitb-ui/gitb-ui /usr/local/gitb-ui
COPY --from=builder /app/etc/docker/gitb-ui/gitb-entrypoint.sh /usr/local/gitb-ui/bin
RUN mkdir -p /usr/local/gitb-ui/conf/extra-configs \
    && if [ -n "$APPLICATION_SECRET" ]; then printf '%s' "$APPLICATION_SECRET" > /usr/local/gitb-ui/conf/extra-configs/APPLICATION_SECRET; fi \
    && if [ -n "$HMAC_KEY" ]; then printf '%s' "$HMAC_KEY" > /usr/local/gitb-ui/conf/extra-configs/HMAC_KEY; fi \
    && if [ -n "$MASTER_PASSWORD" ]; then printf '%s' "$MASTER_PASSWORD" > /usr/local/gitb-ui/conf/extra-configs/MASTER_PASSWORD; fi \
    && if [ -n "$DB_DEFAULT_PASSWORD" ]; then printf '%s' "$DB_DEFAULT_PASSWORD" > /usr/local/gitb-ui/conf/extra-configs/DB_DEFAULT_PASSWORD; fi
RUN chmod +x /usr/local/gitb-ui/bin/gitb-entrypoint.sh

EXPOSE 9000
EXPOSE 9090
WORKDIR /usr/local/gitb-ui

ENTRYPOINT ["/usr/local/gitb-ui/bin/gitb-entrypoint.sh"]
