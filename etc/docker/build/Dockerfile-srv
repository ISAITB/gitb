# Stage 1: Build app
FROM maven:3.9.8-amazoncorretto-21 AS builder

WORKDIR /app
COPY . /app
RUN mvn clean install -DskipTests=true -Denv=docker

# Stage 2: Run application
FROM eclipse-temurin:21-jre-jammy

ARG HMAC_KEY=""

RUN mkdir /itbsrv
COPY --from=builder /app/gitb-testbed-service/target/itbsrv.war /itbsrv
RUN mkdir -p /itbsrv/extra-configs \
	&& if [ -n "$HMAC_KEY" ]; then printf '%s' "$HMAC_KEY" > /itbsrv/extra-configs/HMAC_KEY; fi
RUN sh -c 'touch /itbsrv/itbsrv.war'

EXPOSE 8080-8090
EXPOSE 80
WORKDIR /itbsrv

ENTRYPOINT ["java","-Djava.security.egd=file:/dev/./urandom","-jar","/itbsrv/itbsrv.war"]
