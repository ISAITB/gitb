# Stage 1: Build app
FROM maven:3.9.8-amazoncorretto-21 AS builder

WORKDIR /app
COPY . /app
RUN mvn clean install -DskipTests=true -Denv=docker

# Stage 2: Run application
FROM eclipse-temurin:21-jre-jammy

RUN mkdir /itbsrv
COPY --from=builder /app/gitb-testbed-service/target/itbsrv.war /itbsrv
COPY --from=builder /app/etc/docker/gitb-srv/gitb-entrypoint.sh /itbsrv
RUN sh -c 'touch /itbsrv/itbsrv.war'
RUN chmod +x /itbsrv/gitb-entrypoint.sh

EXPOSE 8080-8090
EXPOSE 80
WORKDIR /itbsrv

ENTRYPOINT ["/itbsrv/gitb-entrypoint.sh"]
